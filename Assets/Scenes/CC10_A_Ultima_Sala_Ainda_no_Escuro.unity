  subtitles:
  - start: 0.08
    end: 2.88
    speaker: NARRADOR
    text: "A \xFAltima conex\xE3o n\xE3o se fechou a tempo."
    voice: {fileID: 0}
  - start: 3.06
    end: 6.9
    speaker: NARRADOR
    text: "A manh\xE3 encontrou a obra intacta, mas o sal\xE3o ainda precisava de energia."
    voice: {fileID: 0}
  - start: 7.02
    end: 8.8
    speaker: "SEGURAN\xC7A"
    text: "O Sal\xE3o Principal precisa de uma revis\xE3o antes de abrir."
    voice: {fileID: 0}
  - start: 8.82
    end: 10.94
    speaker: CURADORIA
    text: "Vamos manter esta sala fechada. O restante est\xE1 seguro."
    voice: {fileID: 0}
  - start: 11.18
    end: 14.92
    speaker: NARRADOR
    text: A abertura daquela sala ficou para depois.
    voice: {fileID: 0}
