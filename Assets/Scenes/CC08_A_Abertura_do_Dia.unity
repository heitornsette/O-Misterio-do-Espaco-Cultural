  subtitleBackground: {fileID: 655962776}
  subtitleText: {fileID: 2096951894}
  lobbyDaylight: {fileID: 634143034}
  finalFade: {fileID: 1676256813}
  subtitles:
  - start: 0.16
    end: 3.78
    speaker: NARRADOR
    text: "\xC0s seis, a madrugada cedeu lugar ao dia."
    voice: {fileID: 0}
  - start: 4.12
    end: 8.74
    speaker: NARRADOR
    text: "A exposi\xE7\xE3o estava pronta para receber seus visitantes."
    voice: {fileID: 0}
  - start: 9.22
    end: 12
    speaker: CURADORA
    text: "Est\xE1 tudo pronto para a inaugura\xE7\xE3o."
    voice: {fileID: 0}
  - start: 12.18
    end: 15.76
    speaker: "SEGURAN\xC7A"
    text: Bom dia. Tudo em ordem.
    voice: {fileID: 0}
  - start: 16.18
    end: 19.86
    speaker: NARRADOR
    text: "Para o seguran\xE7a, a madrugada tinha terminado."
    voice: {fileID: 0}
  - start: 20.24
    end: 24.55
    speaker: NARRADOR
    text: No gramado, a mariposa pousou. Moema enfim descansou.
    voice: {fileID: 0}
