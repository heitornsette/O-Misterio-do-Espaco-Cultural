  stairLightFlash: {fileID: 338700644}
  clockText: {fileID: 408013812}
  subtitleText: {fileID: 1816217865}
  titleText: {fileID: 1582252031}
  vignetteImage: {fileID: 1495918691}
  fadeImage: {fileID: 403708194}
  subtitles:
  - start: 0.55
    end: 3.75
    speaker: NARRADOR
    text: "\xC0s duas da manh\xE3, o Espa\xE7o Cultural ainda dormia."
    voice: {fileID: 0}
  - start: 4.05
    end: 6.1
    speaker: NARRADOR
    text: "Faltavam quatro horas para a inaugura\xE7\xE3o."
    voice: {fileID: 0}
  - start: 10.05
    end: 13.8
    speaker: NARRADOR
    text: A ronda deveria ser tranquila.
    voice: {fileID: 0}
  - start: 14.1
    end: 17.3
    speaker: NARRADOR
    text: O barulho no andar de cima mudou os planos.
    voice: {fileID: 0}
  - start: 17.35
    end: 19.75
    speaker: "SEGURAN\xC7A"
    text: "Eu s\xF3 queria uma noite tranquila."
    voice: {fileID: 0}
  - start: 20.1
    end: 22.7
    speaker: NARRADOR
    text: "Na poeira, tr\xEAs dedos deixaram a primeira pista."
    voice: {fileID: 0}
  - start: 22.75
    end: 25.8
    speaker: "SEGURAN\xC7A"
    text: "Isso n\xE3o parece pegada de sapato."
    voice: {fileID: 0}
  - start: 26.1
    end: 29.4
    speaker: NARRADOR
    text: "A trilha come\xE7ava ali, mas sua raz\xE3o ainda estava escondida."
    voice: {fileID: 0}
  - start: 29.45
    end: 31.8
    speaker: "SEGURAN\xC7A"
    text: Vamos ver o que aconteceu.
    voice: {fileID: 0}
  voiceSource: {fileID: 1504147089}
  ambientSource: {fileID: 1504147088}
  effectsSource: {fileID: 1504147087}
