  - {fileID: 21300000, guid: fdff933f61483e2daa7c4dc652e4f143, type: 2}
  featherAtPanel: {fileID: 1462243749}
  featherAtCable: {fileID: 0}
  panelGlow: {fileID: 693102487}
  memoryRoomLight: {fileID: 1062617270}
  subtitleBackground: {fileID: 543206488}
  subtitleText: {fileID: 1292291085}
  fadeImage: {fileID: 1865173507}
  memoryTint: {fileID: 366042919}
  memoryBorder: {fileID: 1858910318}
  memoryLabel: {fileID: 1673368153}
  blackoutOverlay: {fileID: 419130556}
  subtitles:
  - start: 0.12
    end: 2.82
    speaker: NARRADOR
    text: Aquela pequena visitante era a pista que faltava.
    voice: {fileID: 0}
  - start: 3.04
    end: 4.58
    speaker: NARRADOR
    text: A porta ficara aberta durante os preparativos.
    voice: {fileID: 0}
  - start: 4.64
    end: 6.58
    speaker: NARRADOR
    text: Moema seguiu o inseto, esbarrando nas obras.
    voice: {fileID: 0}
  - start: 6.82
    end: 10.86
    speaker: NARRADOR
    text: "No sal\xE3o, ela mordeu um cabo solto ao tentar alcan\xE7\xE1-lo."
    voice: {fileID: 0}
  - start: 11.12
    end: 13.08
    speaker: NARRADOR
    text: "N\xE3o houve plano nem maldade. Foi curiosidade \u2014 e um susto no escuro."
    voice: {fileID: 0}
  - start: 13.22
    end: 14.88
    speaker: "SEGURAN\xC7A"
    text: "Ent\xE3o era s\xF3 isso..."
    voice: {fileID: 0}
  voiceSource: {fileID: 903547423}
  ambienceSource: {fileID: 1024713582}
  effectsSource: {fileID: 466460083}
